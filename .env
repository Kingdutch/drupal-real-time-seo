################################################################################
# Image Versioning                                                             #
################################################################################
# The version of the Nginx base image.
NGINX_VERSION=1.25.1

# The version of the PHP base image and extensions.
PHP_VERSION=8.3

# The version of our build tools.
COMPOSER_VERSION=2.5.5

# The version of supporting services that we develop and deploy with.
MARIADB_VERSION=10.11

# The version of development services that we use.
CHROME_VERSION=102

################################################################################
# Development Settings                                                         #
#                                                                              #
# These settings control your local development environment and you should     #
# free to change them if you need to.                                          #
################################################################################
## MariaDB Docker Image settings
MARIADB_DATABASE=rtseo
MARIADB_ROOT_PASSWORD=root

# The needed alias for our router to be reachable at the correct internal
# location
RTSEO_ROUTER_ALIAS=localhost

################################################################################
# Infrastructure settings                                                      #
#                                                                              #
# These settings are used to control infrastructure settings such as the       #
# upstreams for routers.                                                       #
################################################################################
RTSEO_ROUTER_UPSTREAM=php-fpm:9000

################################################################################
# Application settings                                                         #
#                                                                              #
# These settings are also needed outide of development and will generally be   #
# set using a secret manager or a production specfic .env file.                #
################################################################################
## Database settings
RTSEO_DATABASE=rtseo
RTSEO_DATABASE_USERNAME=root
RTSEO_DATABASE_PASSWORD=root
RTSEO_DATABASE_HOST=database
RTSEO_DATABASE_PORT=3306

## Drupal's private file system path
RTSEO_PRIVATE_FILE_PATH=/app/files_private

## Drupal secrets (e.g. used for hash_salt)
RTSEO_PROJECT_ENTROPY=thisisnotrandom
