{
    "name": "kingdutch/rtseo_dev",
    "description": "Development environment for the Drupal Real-Time SEO module",
    "type": "project",
    "license": "GPLv2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\yoast_seo\\": "html/modules/yoast_seo/tests/src"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "html/libraries/rtseo.js"
        },
        {
            "type": "path",
            "url": "html/modules/yoast_seo"
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "drupal/yoast_seo": "self.version"
    },
    "require-dev": {
        "composer/installers": "^2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1",
        "dmore/behat-chrome-extension": "^1.4",
        "drupal/coder": "^8",
        "drupal/core": "^11.2",
        "drupal/core-composer-scaffold": "^11",
        "drupal/devel": "^5",
        "drupal/drupal-extension": "^5.1",
        "drupal/paragraphs": "^1",
        "drush/drush": "^13.0",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "mglaman/phpstan-drupal": "^2",
        "mikey179/vfsstream": "^1.6.11",
        "phpspec/prophecy-phpunit": "^2",
        "phpstan/extension-installer": "^1.4.2",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpunit/phpunit": "^10",
        "symfony/phpunit-bridge": "^7.3"
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/modules/yoast_seo": [
                "drupal/yoast_seo"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/contrib/${name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "html/libraries/rtseo.js": [
                "goalgorilla/rtseo.js"
            ],
            "html/libraries/{$name}": [
                "type:drupal-library"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        }
    }
}
