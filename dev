#!/bin/bash

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper function to print colored output
print_info() {
    echo -e "${GREEN}[INFO]${NC} $1" >&2
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1" >&2
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# Command functions
cmd_build() {
  docker compose build
  docker compose --profile cli build cli
}

cmd_build_help() {
  echo "Rebuild the Docker containers"
  echo "Usage: $0 build"
}

cmd_up() {
  docker compose up -d $@
}

cmd_up_help() {
  echo "Start the Docker containers"
  echo "Usage: $0 up"
}

cmd_stop() {
  docker compose stop $@
}

cmd_stop_help() {
  echo "Stop the Docker containers"
  echo "Usage: $0 stop"
}

cmd_down() {
  docker compose down $@
}

cmd_down_help() {
  echo "Remove the Docker containers"
  echo "Usage: $0 down"
}

cmd_install() {
  docker compose run --rm --no-deps cli drush site-install --yes --account-name=admin --account-pass=admin --account-mail='admin@example.com' --site-name='Real-Time SEO Development'
  docker compose run --rm --no-deps cli drush en -y yoast_seo
}

cmd_install_help() {
  echo "Install the site and the module for test"
  echo "Usage: $0 down"
}

cmd_cli() {
  docker compose run --rm --no-deps cli $@
}

cmd_cli_help() {
  echo "Execute something using the Docker compose CLI container"
  echo "Usage: $0 cli"
}

cmd_drush() {
  docker compose run --rm --no-deps cli drush $@
}

cmd_drush_help() {
  echo "Execute Drush"
  echo "Usage: $0 drush"
}

cmd_behat() {
  docker compose run --rm --no-deps cli behat --config html/modules/yoast_seo/tests/behat.yml $@
}

cmd_behat_help() {
    echo "Run the Behat tests"
    echo "Usage: $0 behat"
}

cmd_phpstan() {
    docker compose run --rm --no-deps cli phpstan analyse --configuration html/modules/yoast_seo/phpstan.neon --memory-limit=-1 html/modules/yoast_seo $@
}

cmd_phpstan_help() {
    echo "Run PHPStan static analysis on the Yoast SEO module"
    echo "Usage: $0 phpstan"
}

cmd_phpcs() {
    docker compose run --rm --no-deps cli phpcs --standard=html/modules/yoast_seo/phpcs.xml html/modules/yoast_seo
}

cmd_phpcs_help() {
    echo "Run PHPCS code linting"
    echo "Usage: $0 phpcs"
}

cmd_phpunit() {
    docker compose run --rm --no-deps -e SIMPLETEST_BASE_URL='http://localhost' -e SIMPLETEST_DB='mysql://root:root@database/rtseo' -e BROWSERTEST_OUTPUT_DIRECTORY='/app/html/sites/simpletest/browser_output' cli phpunit --configuration=/app/html/modules/yoast_seo/phpunit.xml $@
}

cmd_phpunit_help() {
    echo "Run PHPUnit tests"
    echo "Usage: $0 phpunit"
}

# Help function
show_help() {
    echo "Development script for managing common tasks"
    echo ""
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Available commands:"

    # Auto-discover commands by looking for cmd_* functions
    for func in $(declare -F | grep -o 'cmd_[a-zA-Z0-9_]*' | grep -v '_help$' | sort); do
        cmd_name=${func#cmd_}
        echo "  $cmd_name"

        # Check if help function exists and call it with indentation
        if declare -F "cmd_${cmd_name}_help" > /dev/null; then
            cmd_${cmd_name}_help | sed 's/^/    /'
        fi
        echo ""
    done

    echo "Use '$0 help' to show this help message"
}

# Main function
main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 1
    fi

    command=$1
    shift

    # Handle help commands
    if [[ "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
        show_help
        return 0
    fi

    # Check if command function exists
    if declare -F "cmd_$command" > /dev/null; then
        cmd_$command "$@"
    else
        print_error "Unknown command: $command"
        echo ""
        show_help
        exit 1
    fi
}

# Run main function with all arguments
main "$@"
